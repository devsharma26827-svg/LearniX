# ==============================================================================
# LearniX (EduPulse AI OS) - Production & Development Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=4242
NODE_ENV=development

# Multi-Tenant Cloud Database
# To use SQLite (local fast embedded storage, default): leave DATABASE_URL blank or unset.
# To use PostgreSQL (Render, Supabase, Neon, AWS RDS): provide postgres connection string:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/learnix
DATABASE_SSL=True
# SQLITE_DB_PATH=.data/edupulse.sqlite

# Security & Sessions
# Generated 64-character secret for cookie signing & CSRF token hashing
SESSION_SECRET=change-this-in-production-to-a-random-32-byte-hex-string
ALLOWED_ORIGINS=http://localhost:4242,http://127.0.0.1:4242

# Multi-User Demo Account Toggle
# Set to false in production to disable pre-seeded demo user and sample lectures.
ENABLE_DEMO_ACCOUNT=true
DEMO_STUDENT_PASSWORD=DemoStudent@123

# Artificial Intelligence & Speech-to-Text (Google Gemini API)
# Get your Gemini API key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Speech Model Selection (Recommended: gemini-2.5-flash or gemini-2.0-flash)
GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-flash

# Storage Configuration
# local (default) or s3
STORAGE_PROVIDER=local
# LOCAL_STORAGE_DIR=.data/audio_chunks

# Optional S3/Cloudflare R2/MinIO Configuration (if STORAGE_PROVIDER=s3)
# S3_BUCKET_NAME=learnix-audio
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
